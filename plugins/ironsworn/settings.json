{
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/media/karim/Code-Drive/karimn-code/rpg-rules"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(bun test *)",
      "Bash(bun run *)",
      "Bash(cd * && bun test*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash plugins/ironsworn/scripts/check-version-bump.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
